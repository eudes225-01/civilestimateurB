# Copier ce fichier en .env et renseigner les valeurs nécessaires.
# Toutes les variables ont une valeur par défaut raisonnable sauf
# ANTHROPIC_API_KEY (requise pour /api/analyse-plan) et, pour le paiement,
# FEDAPAY_SECRET_KEY + SUPABASE_SERVICE_ROLE_KEY.

# Port d'écoute du serveur Express
PORT=8080

# Origines autorisées en CORS, séparées par des virgules (SANS slash final)
ALLOWED_ORIGINS=http://localhost:5173,https://civilestimator-archinova.store,https://civilestimateur-archinova.vercel.app

# Date de lancement — la période gratuite dure 3 mois à partir de cette date
LANCEMENT_DATE=2026-06-26T00:00:00Z

# Comptes — Supabase (connexion Google). Voir docs/AUTH-GOOGLE.md côté frontend.
# SUPABASE_URL : https://<projet>.supabase.co ; SUPABASE_ANON_KEY : clé publique « anon ».
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Connexion exigée pour /api/analyse-plan. Défaut : true en production, false sinon.
REQUIRE_AUTH=

# Clé API Anthropic — nécessaire pour /api/analyse-plan (lecture de plan).
# Sans elle, la route répond 501 (fonctionnalité non configurée).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=16000

# ── Paiement FedaPay (abonnement Premium) ─────────────────────────────────────
# 1) Compte FedaPay → Paramètres → Clés API : copier la clé SECRÈTE (sk_sandbox_… pour les
#    essais, sk_live_… en production). Ne jamais la mettre côté frontend.
FEDAPAY_SECRET_KEY=
# sandbox | live. Laisser vide : déduit du préfixe de la clé.
FEDAPAY_ENV=
# 2) FedaPay → Webhooks → Créer : URL https://<votre-backend>/api/fedapay/webhook,
#    événements transaction.approved (et declined/canceled si voulu). Copier le secret « whsec_… ».
FEDAPAY_WEBHOOK_SECRET=
# Page du frontend où FedaPay renvoie le client après paiement (vide : origine du site appelant).
# Exemple : https://civilestimator-archinova.store
FEDAPAY_CALLBACK=
# Prix et durée de l'abonnement (fixés ici, jamais par le navigateur).
FEDAPAY_MONTANT=5000
FEDAPAY_DUREE_JOURS=30
# 3) Supabase → Project Settings → API → clé « service_role » (SECRÈTE, serveur uniquement).
#    Sert à enregistrer les abonnements. Exécuter aussi supabase/schema.sql (section migration).
SUPABASE_SERVICE_ROLE_KEY=

# ── E-mails — Resend (https://resend.com) ─────────────────────────────────────
# Clé API : Resend → API Keys. Vide : aucun e-mail n'est envoyé (le reste fonctionne).
RESEND_API_KEY=
# Expéditeur : doit utiliser le domaine vérifié dans Resend (Resend → Domains).
EMAIL_FROM=CivilEstimateur <no-reply@civilestimator-archinova.store>
# Reçoivent la notification « paiement reçu » : une ou plusieurs adresses séparées par des virgules
# (max 50). Ex. : EMAIL_ADMIN=moi@gmail.com,testeur1@gmail.com,testeur2@gmail.com
EMAIL_ADMIN=archinova87@gmail.com
# Adresse de réponse des clients (facultatif).
EMAIL_REPLY_TO=
# Lien des boutons dans les mails (vide : FEDAPAY_CALLBACK, sinon première origine https).
APP_URL=
# Rappel quand il reste au plus N jours d'abonnement.
RAPPEL_JOURS=3
# Secret de la tâche quotidienne POST /api/cron/echeances (chaîne aléatoire longue). Vide : route désactivée.
CRON_SECRET=
